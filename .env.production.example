# Copy to .env.production and replace every example value before deployment.
# This file contains no secrets; TLS private-key paths must point to protected host files.
PUBLIC_API_PORT=443
PARALAB_CORS_ORIGINS=https://app.example.com
TLS_CERT_PATH=./deploy/tls/fullchain.pem
TLS_KEY_PATH=./deploy/tls/privkey.pem
# Ignored local model bundle; it is mounted read-only into model-gateway.
PARALAB_MODEL_DIR=./models/sentence-transformer
