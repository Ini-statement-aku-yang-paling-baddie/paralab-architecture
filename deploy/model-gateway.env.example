# Copy to a private .env file on the Linux host. Do not commit the private file.
# All model paths must be local directories on the host; no runtime download is
# required once the artifacts have been copied and verified.

PARALAB_MODEL_ROOT=/opt/paralab/models
PARALAB_QWEN_BASE_DIR=/opt/paralab/models/Qwen2.5-1.5B-Instruct
PARALAB_QWEN_LORA_DIR=/opt/paralab/models/formulab_qwen_lora/qwen25-15b-formulab-lora
PARALAB_F1_EMBEDDING_MODEL_DIR=/opt/paralab/models/embedding_model

# RTX 4050 Laptop GPU: begin conservatively. One model process and one active
# generation avoids duplicated Qwen weights and protects its 6 GB VRAM.
PARALAB_DEVICE=cuda
PARALAB_TORCH_DTYPE=bfloat16
PARALAB_MODEL_CONCURRENCY=1
PARALAB_MAX_INPUT_TOKENS=2048
PARALAB_MAX_NEW_TOKENS=256
PARALAB_REQUEST_TIMEOUT_SECONDS=90

# F5 audio safety limits. ffmpeg must be installed at OS level.
PARALAB_MAX_AUDIO_MB=20
PARALAB_F5_LANGUAGE=id

# Comma-separated, explicit browser origins. Never use * for a public tunnel.
PARALAB_CORS_ORIGINS=https://<website-domain>
